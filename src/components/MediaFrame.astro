---
interface Props {
  src: string;
  alt?: string;
  shape?: 'portrait' | 'wide';
  width?: number;
  height?: number;
}

const { src, alt = '', shape = 'wide', width = 1600, height = 600 } = Astro.props;
---

<div class:list={['media-frame', shape === 'portrait' ? 'media-portrait' : 'media-wide']} data-reveal>
  <div data-kb>
    <img src={src} alt={alt} loading="lazy" width={width} height={height} />
  </div>
</div>
