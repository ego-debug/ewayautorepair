---
interface Props {
  eyebrow?: string;
  quote: string;
  src?: string;
  alt?: string;
}

const {
  eyebrow = 'On Site',
  quote,
  // PLACEHOLDER image. Replace with a wide shot of him working on a car in a
  // driveway with the tools out.
  src = '/images/workband-placeholder.svg',
  alt = '',
} = Astro.props;
---

<section class="work-band">
  <div class="band-parallax" data-parallax data-parallax-rate="0.18">
    <div data-kb>
      <img src={src} alt={alt} loading="lazy" width="2000" height="900" />
    </div>
  </div>
  <div class="band-scrim"></div>
  <div class="inner">
    <div>
      <div class="eyebrow" data-reveal>{eyebrow}</div>
      <p class="quote" data-reveal>{quote}</p>
    </div>
  </div>
</section>
