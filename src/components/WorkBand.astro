---
interface Props {
  eyebrow?: string;
  quote: string;
  src?: string;
  alt?: string;
}

const {
  eyebrow = 'On Site',
  quote,
  src = '/images/driveway.webp',
  alt = 'A car with the hood up in a residential driveway, work lamp and tools out',
} = Astro.props;
---

<section class="work-band">
  <div class="band-parallax" data-parallax data-parallax-rate="0.18">
    <div data-kb>
      <img src={src} alt={alt} loading="lazy" decoding="async" width="1916" height="821" />
    </div>
  </div>
  <div class="band-scrim"></div>
  <div class="inner">
    <div>
      <div class="eyebrow" data-reveal>{eyebrow}</div>
      <p class="quote" data-reveal>{quote}</p>
    </div>
  </div>
</section>
