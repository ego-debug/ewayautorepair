---
import { PHONE, TEL_HREF } from '../data/site';

const NAV = [
  { href: '/services', label: 'Services' },
  { href: '/pre-purchase-inspection', label: 'Pre-Purchase Inspection' },
  { href: '/brands', label: 'Brands' },
  { href: '/about', label: 'About' },
  { href: '/service-area', label: 'Service Area' },
  { href: '/contact', label: 'Contact' },
];

const here = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header" id="site-header">
  <div class="row">
    <a href="/" class="wordmark" aria-label="Eway Auto Repairs home">
      <span class="mark">EWAY AUTO REPAIRS</span>
      <span class="tagline desktop-only">EUROPEAN SPECIALIST</span>
    </a>
    <nav class="site-nav desktop-only" aria-label="Main">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={here === item.href || here.startsWith(`${item.href}/`) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <a href={TEL_HREF} class="btn-call">Call {PHONE}</a>
  </div>
  <div class="scroll-progress" data-progress></div>
</header>
