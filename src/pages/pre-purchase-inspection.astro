---
import Page from '../layouts/Page.astro';
import PageIntro from '../components/PageIntro.astro';
import CtaBand from '../components/CtaBand.astro';
import { PHONE, TEL_HREF } from '../data/site';
import { serviceSchema, faqSchema } from '../data/schema';

const title = 'Pre-Purchase Inspection for European Cars | South Jersey Mobile PPI';
const description = `Mobile pre-purchase inspection for BMW, Mercedes, Audi, Porsche, Land Rover and more. 30+ years, ASE Master certified. I inspect the car at the seller's location. South Jersey. Call ${PHONE}.`;

const included = [
  'Every control module scanned for current and stored faults, including the freeze-frame data most sellers have no idea is stored in there',
  'Service history and maintenance intervals reviewed',
  'Engine, transmission, and drivetrain inspection',
  'Cooling system, leaks, and the condition of every fluid',
  'Suspension, steering, brakes, tires',
  'Undercarriage, rust, and evidence of prior accident work',
  'The failure points specific to that model and that year',
  'Electrical systems and every option checked for function',
  'Photos throughout',
  'A written report, and a phone call to talk through what I found',
];

// [ANSWER] placeholders below need the technician's real answers before launch.
const faqs = [
  {
    q: 'Can you inspect a car at a dealership?',
    a: "Most dealers allow it. I'll coordinate with them.",
  },
  {
    q: 'How far will you travel?',
    a: '[ANSWER — how far he will actually drive for an inspection]',
  },
  {
    q: 'How soon can you get out there?',
    a: '[ANSWER — realistic scheduling turnaround]',
  },
  {
    q: "What if the seller won't allow an inspection?",
    a: "That's your answer about the car.",
  },
  {
    q: 'Do you inspect private-party sales?',
    a: "Yes. That's where an inspection matters most.",
  },
];

const schemas = [
  serviceSchema(
    'Pre-Purchase Inspection',
    "Mobile pre-purchase inspection for European cars at the seller's location in South Jersey.",
    '/pre-purchase-inspection'
  ),
  faqSchema(faqs),
];
---

<Page title={title} description={description} path="/pre-purchase-inspection" schemas={schemas}>
  <PageIntro eyebrow="Pre-Purchase Inspection">
    <Fragment slot="title">
      Before You Buy That <span class="accent">European Car</span>
    </Fragment>
    <Fragment slot="intro">
      A used European car is either the best value on the road or the most expensive mistake
      you will ever make, and a test drive almost never tells you which one you are looking at.
    </Fragment>
  </PageIntro>

  <section class="section-ruled">
    <div class="section container">
      <div class="copy">
        <p>
          I inspect the car <strong>where it sits</strong>, before you hand anybody money. You
          get photos, a scan of every module, and a straight answer on the only question that
          matters: should you buy this car, and what is it going to cost you over the next year?
        </p>
      </div>

      <h2 style="margin-top:56px" data-reveal>What's included</h2>
      <ul class="check-list">
        {included.map((item) => <li data-reveal>{item}</li>)}
      </ul>

      <!-- PLACEHOLDER price — brief suggests $250–$300; don't go under $200. -->
      <div class="price-block" data-reveal>
        <span class="price">[$XXX] flat</span>
        <span class="note">Most inspections run 60 to 90 minutes.</span>
      </div>

      <div class="copy" style="margin-top:48px">
        <p>
          <strong>I have no connection to the seller and no stake in whether you buy the
          car.</strong> If it's a good one I'll tell you that. If it's sitting on six thousand
          dollars of deferred maintenance, you'll know before you sign, and that's either a
          negotiation or a reason to walk away.
        </p>
      </div>

      <h2 style="margin-top:56px" data-reveal>Questions people ask</h2>
      <div class="faq">
        {
          faqs.map((f) => (
            <div class="faq-item" data-reveal>
              <h3>{f.q}</h3>
              <p>{f.a}</p>
            </div>
          ))
        }
      </div>

      <div class="next-links">
        <a class="chip-link" href="/brands">Failure points by marque</a>
        <a class="chip-link" href="/services">All services</a>
        <a class="chip-link" href="/service-area">Where I'll travel</a>
        <a class="chip-link" href="/contact">Book an inspection</a>
      </div>
    </div>
  </section>

  <CtaBand
    title="Found a car worth a look?"
    sub={`Call ${PHONE} with the listing and I'll tell you what that model's known weak points are before we even schedule anything.`}
  />
</Page>
