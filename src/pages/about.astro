---
import Page from '../layouts/Page.astro';
import PageIntro from '../components/PageIntro.astro';
import CtaBand from '../components/CtaBand.astro';
import MediaFrame from '../components/MediaFrame.astro';
import { CREDENTIALS } from '../data/site';

const title = '30+ Years on European Cars | About Eway Auto Repairs';
const description =
  'The technician behind Eway Auto Repairs: 30+ years on European platforms, ASE Master and L1 certified, factory-trained. Mobile European auto repair in South Jersey.';
---

<Page title={title} description={description} path="/about">
  <PageIntro eyebrow="About">
    <Fragment slot="title">30+ Years on <span class="accent">European Cars</span></Fragment>
    <Fragment slot="intro">
      One technician. Whoever answers the phone is the same person who diagnoses your car and
      does the work on it.
    </Fragment>
  </PageIntro>

  <section class="section-ruled">
    <div class="section container about-grid">
      <div>
        <!-- PLACEHOLDER: replace with his real story, in his words (3 or 4 sentences):
             where he trained, what he's worked on, that he owned his own shop,
             why European cars specifically. A real photo of him working converts far
             better than a stock engine bay. -->
        <div class="copy">
          <p>[HIS STORY: 3 or 4 sentences: where he trained, the shop he owned, what he's
          worked on, and why European cars specifically. Record him telling it and type it
          up close to how he said it. Plain words beat polished copy here, and a real story
          is the one thing on this site nobody can copy.]</p>
          <p>
            Right now Eway runs mobile. For most diagnostics, inspections, and maintenance
            that works out better for you than dropping the car off for three days. The plan
            is a European-only shop here in South Jersey, and the customers I take care of
            now are the ones I'll be taking care of there.
          </p>
        </div>
      </div>
      <div>
        <!-- PLACEHOLDER: swap for a real photo of him with the car, decent lighting -->
        <MediaFrame
          src="/images/portrait-placeholder.svg"
          shape="portrait"
          width={800}
          height={1000}
          alt=""
        />
        <div class="credential-list" style="margin-top:32px">
          {
            CREDENTIALS.map((c) => (
              <div class="credential-row" data-reveal>
                <span class="square" data-pip></span>
                <span class="label">{c}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section-alt">
    <div class="section container">
      <h2 data-reveal>What the certifications actually mean</h2>
      <div class="failure-list">
        <div class="failure-item" data-reveal>
          <h3>ASE Master Technician</h3>
          <p>Certified across all eight core automotive areas: engine repair, transmission, drivetrain, suspension and steering, brakes, electrical, HVAC, and engine performance.</p>
        </div>
        <div class="failure-item" data-reveal>
          <h3>ASE L1 Advanced Engine Performance</h3>
          <p>The advanced diagnostic certification, sat on top of Master status. Fewer than one technician in ten holds it. This is the one that covers actually diagnosing a driveability problem rather than reading the code off it.</p>
        </div>
        <div class="failure-item" data-reveal>
          <h3>Factory-Trained</h3>
          <p>[BRANDS: list which manufacturers' factory training he completed]</p>
        </div>
        <div class="failure-item" data-reveal>
          <h3>NJ Certified Emission Repair Technician</h3>
          <p>Licensed by New Jersey to repair vehicles that failed state emissions inspection. This is the certification required to get a failed car legally back on the road.</p>
        </div>
      </div>
      <div class="next-links">
        <a class="chip-link" href="/services">What I do</a>
        <a class="chip-link" href="/brands">Brands I work on</a>
        <a class="chip-link" href="/contact">Get in touch</a>
      </div>
    </div>
  </section>

  <CtaBand />
</Page>
