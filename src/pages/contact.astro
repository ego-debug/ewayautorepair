---
import Page from '../layouts/Page.astro';
import PageIntro from '../components/PageIntro.astro';
import { PHONE, TEL_HREF } from '../data/site';

const title = 'Contact and Quote Requests | Eway Auto Repairs';
const description = `Send the year, model and symptoms and get a written estimate before any work starts. Or call ${PHONE}. Mobile European auto repair, South Jersey.`;
---

<Page title={title} description={description} path="/contact">
  <PageIntro eyebrow="Contact">
    <Fragment slot="title">Tell me what it's <span class="accent">doing</span>.</Fragment>
    <Fragment slot="intro">
      Send the details and I will come back to you with what I think it is and what it
      costs to find out for certain. I am usually under a car during the day, so this
      reaches me more reliably than a missed call.
    </Fragment>
  </PageIntro>

  <section class="section-ruled">
    <div class="section container">
      <form
        id="quote-form"
        class="contact-form"
        method="POST"
        action="/api/quote"
        data-tel={TEL_HREF}
        data-phone={PHONE}
        novalidate
      >
        <!-- Honeypot. Positioned off-screen, so only a bot fills it. -->
        <div class="hp-field" aria-hidden="true">
          <label for="f-company">Company</label>
          <input id="f-company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <input type="hidden" name="started_at" id="started-at" value="" />

        <div class="form-field wide">
          <label for="f-urgency">How urgent is it? <span class="req">*</span></label>
          <select id="f-urgency" name="urgency" required>
            <option value="soon">It drives, but it needs looking at</option>
            <option value="undriveable">The car is not driveable right now</option>
            <option value="planning">Planning ahead, or a pre-purchase inspection</option>
          </select>
        </div>

        <div class="form-field">
          <label for="f-name">Name <span class="req">*</span></label>
          <input id="f-name" name="name" type="text" required autocomplete="name" />
        </div>
        <div class="form-field">
          <label for="f-phone">Phone <span class="req">*</span></label>
          <input id="f-phone" name="phone" type="tel" required autocomplete="tel" />
        </div>
        <div class="form-field">
          <label for="f-email">Email</label>
          <input id="f-email" name="email" type="email" autocomplete="email" />
          <span class="field-hint">Only used to send you a copy of this.</span>
        </div>
        <div class="form-field">
          <label for="f-contact-pref">Best way to reach you</label>
          <select id="f-contact-pref" name="contact_pref">
            <option value="">No preference</option>
            <option>Call</option>
            <option>Text</option>
            <option>Email</option>
          </select>
        </div>

        <div class="form-field">
          <label for="f-vehicle">Year / Make / Model <span class="req">*</span></label>
          <input id="f-vehicle" name="vehicle" type="text" required placeholder="2016 BMW 340i" />
        </div>
        <div class="form-field">
          <label for="f-mileage">Mileage</label>
          <input id="f-mileage" name="mileage" type="text" inputmode="numeric" />
        </div>
        <div class="form-field">
          <label for="f-town">Town <span class="req">*</span></label>
          <input id="f-town" name="town" type="text" required placeholder="Cherry Hill" />
        </div>

        <div class="form-field wide">
          <label for="f-symptoms">What's it doing? <span class="req">*</span></label>
          <textarea
            id="f-symptoms"
            name="symptoms"
            required
            placeholder="Check engine light, rattle on cold start, an estimate you want a second opinion on. Plain words are fine, and the more specific the better."
          ></textarea>
        </div>
        <div class="form-field wide">
          <label for="f-source">How'd you hear about us?</label>
          <select id="f-source" name="heard_from">
            <option value="">Choose one (optional)</option>
            <option>Google search</option>
            <option>Friend or family referral</option>
            <option>Instagram</option>
            <option>Facebook</option>
            <option>Saw the van</option>
            <option>Other</option>
          </select>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn-primary">Send it over</button>
          <span class="note" style="font-size:14px;color:var(--text-faint)">
            You'll get a call back, not a mailing list.
          </span>
        </div>
        <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
      </form>

      <div class="phone-first" data-reveal style="margin-top:44px">
        If the car is not driveable, or it is genuinely urgent, skip the form and call
        <a href={TEL_HREF}>{PHONE}</a>. If I don't pick up I am under a car, so leave a
        message or send a text and I will get straight back to you.
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('quote-form') as HTMLFormElement | null;
    const status = document.getElementById('form-status');
    const startedAt = document.getElementById('started-at') as HTMLInputElement | null;

    // Stamped on load, checked server-side. Instant submissions are bots.
    if (startedAt) startedAt.value = String(Date.now());

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!status || !form.reportValidity()) return;

      const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      button.disabled = true;
      status.className = 'form-status';
      status.textContent = 'Sending…';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const data = await response.json().catch(() => ({}));

        if (response.ok && data.ok) {
          form.hidden = true;
          status.className = 'form-status ok';
          status.innerHTML =
            "<strong>Got it.</strong> I'll come back to you as soon as I'm out from under a car, usually the same day. If you left an email address there is a copy of this in your inbox.";
          status.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return;
        }
        throw new Error(data.error || 'That did not send.');
      } catch (error) {
        status.className = 'form-status err';
        status.innerHTML = `${(error as Error).message} Call or text instead: <a href="${form.dataset.tel}">${form.dataset.phone}</a>`;
        button.disabled = false;
      }
    });
  </script>
</Page>
