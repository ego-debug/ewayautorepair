---
import Page from '../../layouts/Page.astro';
import PageIntro from '../../components/PageIntro.astro';
import CtaBand from '../../components/CtaBand.astro';
import { PHONE } from '../../data/site';
import { BRAND_PAGES } from '../../data/brands';

const title = 'European Brands I Service in South Jersey | Eway Auto Repairs';
const description = `BMW, Mercedes-Benz, Audi, VW, Porsche, Land Rover, Jaguar and more, serviced exclusively, at your driveway in South Jersey. 30+ years, ASE Master certified. Call ${PHONE}.`;

// Saab is the only marque without its own page. Volume does not justify one yet.
const alsoServiced = ['Saab'];
---

<Page title={title} description={description} path="/brands">
  <PageIntro eyebrow="Brands">
    <Fragment slot="title">
      European cars, and <span class="accent">nothing else</span>.
    </Fragment>
    <Fragment slot="intro">
      European work is the whole business here, not one line on a list of services. Thirty
      years on the same platforms with the same tools. Pick your marque below for the
      specifics on what I see go wrong and what it takes to fix it.
    </Fragment>
  </PageIntro>

  <section class="section-ruled">
    <div class="section container">
      <div class="failure-list" style="margin-top:0">
        {
          BRAND_PAGES.map((b) => (
            <a class="failure-item" href={`/brands/${b.slug}`} data-reveal style="display:block">
              <h3 style="color:var(--accent)">{b.name} →</h3>
              <p>{b.intro}</p>
            </a>
          ))
        }
      </div>

      <h2 style="margin-top:64px" data-reveal>Also serviced</h2>
      <p class="section-intro" data-reveal>
        Same tools and the same standards, just not enough of them coming through to warrant
        a page of their own.
      </p>
      <div class="town-row">
        {alsoServiced.map((b) => <span class="town-chip" data-reveal>{b}</span>)}
      </div>

      <div class="next-links">
        <a class="chip-link" href="/pre-purchase-inspection">Pre-Purchase Inspection</a>
        <a class="chip-link" href="/services">All services</a>
        <a class="chip-link" href="/contact">Request a quote</a>
      </div>
    </div>
  </section>

  <CtaBand />
</Page>
