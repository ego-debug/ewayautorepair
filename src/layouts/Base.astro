---
import '@fontsource/archivo/400.css';
import '@fontsource/archivo/500.css';
import '@fontsource/archivo/600.css';
import '@fontsource/archivo/700.css';
import '@fontsource/archivo/800.css';
import '../styles/global.css';
import { DOMAIN } from '../data/site';

interface Props {
  title: string;
  description: string;
  path?: string;
  schemas?: object[];
}

const { title, description, path = '/', schemas = [] } = Astro.props;
const canonical = path === '/' ? `${DOMAIN}/` : `${DOMAIN}${path}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Runs before first paint. Only once this class lands do the reveal styles
         hide anything, so a script failure leaves the page readable instead of blank. -->
    <script is:inline>document.documentElement.classList.add('js-motion');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Eway Auto Repairs" />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <slot />
  </body>
</html>
